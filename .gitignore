# ===========================
# STOCK MANAGEMENT SYSTEM
# Root .gitignore
# ===========================

# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files (NEVER commit these - contain passwords!)
.env
.env.local
.env.development
.env.production
.env.test
*.env

# Build outputs
dist/
build/
out/

# Logs
logs/
*.log

# Database backups (store separately)
backups/*.sql
backups/*.backup

# OS files
.DS_Store
Thumbs.db
desktop.ini

# VS Code settings
.vscode/settings.json
.vscode/launch.json

# TypeScript cache
*.tsbuildinfo

# Coverage reports
coverage/

# Temporary files
tmp/
temp/
